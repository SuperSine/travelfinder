/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": ["jasmine"],
    "skipLibCheck": true
  },
  "files": [
    "src/test.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/app/core/**/*.spec.ts",
    "src/app/features/**/*.spec.ts",
    "src/app/pages/home/**/*.spec.ts",
    "src/app/pages/plan/**/*.spec.ts",
    "src/app/pages/detail/**/*.spec.ts",
    "src/app/app.component.spec.ts",
    "src/app/services/**/*.spec.ts",
    "src/app/shared/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
